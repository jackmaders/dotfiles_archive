[
  {
    "label": "Run Godot 4 Mono project",
    "adapter": "netcoredbg",
    "request": "launch",
    "program": "/run/current-system/sw/bin/godot4-mono",
    "args": ["--path", "${ZED_WORKTREE_ROOT}"],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "build": {
      "command": "dotnet",
      "args": ["build", "${ZED_WORKTREE_ROOT}"]
    }
  }
]
